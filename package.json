{
  "name": "health-assessment-challenge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:test:up": "docker compose -f compose.test.yaml up -d --wait",
    "db:test:down": "docker compose -f compose.test.yaml down -v",
    "db:test:migrate": "node scripts/test-db.mjs migrate",
    "test:integration": "node scripts/test-db.mjs test",
    "postinstall": "prisma generate",
    "test:all": "pnpm test && pnpm test:integration"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "description": "TDD-first full-stack health assessment funnel challenge",
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
