# Application database (set in development/production; never commit real secrets)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/health_assessment?schema=public
# Maximum connections held by the application pg pool. Keep this below the database role limit.
DATABASE_POOL_MAX=4

# Integration-test database. The default test runner uses the Docker Compose value below when omitted.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/health_assessment_test?schema=public

# Optional fixed UUID when creating the evaluator-facing paid demo session.
# If omitted, `pnpm seed:paid-demo` generates one and prints it.
DEMO_SESSION_ID=
