generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  FREE
  ACTIVE
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Goal {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_WEIGHT
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum BmiCategory {
  UNDERWEIGHT
  NORMAL
  OVERWEIGHT
  OBESE
}

enum PaymentStatus {
  SUCCEEDED
}

model AnonymousSession {
  id                 String             @id @default(uuid()) @db.Uuid
  subscriptionStatus SubscriptionStatus @default(FREE) @map("subscription_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  assessment         Assessment?
  paymentEvents      PaymentEvent[]

  @@map("anonymous_sessions")
}

model Assessment {
  id             String            @id @default(uuid()) @db.Uuid
  sessionId      String            @unique @map("session_id") @db.Uuid
  status         AssessmentStatus  @default(IN_PROGRESS)
  revision       Int               @default(0)
  gender         Gender?
  goal           Goal?
  activityLevel  ActivityLevel?    @map("activity_level")
  heightCm       Float?            @map("height_cm")
  weightKg       Float?            @map("weight_kg")
  age            Int?
  targetWeightKg Float?            @map("target_weight_kg")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  completedAt    DateTime?         @map("completed_at")
  session        AnonymousSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  result         AssessmentResult?

  @@map("assessments")
}

model AssessmentResult {
  id                       String      @id @default(uuid()) @db.Uuid
  assessmentId             String      @unique @map("assessment_id") @db.Uuid
  bmi                      Float
  bmiCategory              BmiCategory @map("bmi_category")
  recommendedDailyCalories Int         @map("recommended_daily_calories")
  estimatedGoalDate        DateTime    @map("estimated_goal_date") @db.Date
  calculationVersion       String      @map("calculation_version")
  createdAt                DateTime    @default(now()) @map("created_at")
  assessment               Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_results")
}

model PaymentEvent {
  id             String           @id @default(uuid()) @db.Uuid
  sessionId      String           @map("session_id") @db.Uuid
  idempotencyKey String           @map("idempotency_key") @db.VarChar(128)
  status         PaymentStatus    @default(SUCCEEDED)
  createdAt      DateTime         @default(now()) @map("created_at")
  session        AnonymousSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@map("payment_events")
}
